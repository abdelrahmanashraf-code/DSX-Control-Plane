{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsx-control-plane-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "NODE_STALE_SECONDS": "90",
    "NODE_OFFLINE_SECONDS": "300"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsx-control-plane-dev",
      "database_id": "ff736893-8880-4c3b-b5aa-497bea1a6b87"
    }
  ]
}
