[Unit]
Description=DSX Typed Local Odoo Provisioner
After=postgresql.service nginx.service
Requires=postgresql.service

[Service]
Type=simple
User=root
Group=dsx-agent
ExecStart=/opt/dsx-control-plane/.venv/bin/python -m dsx_node_agent.runtime_service serve --config /etc/dsx-provisioner.json --runtime-config /etc/dsx-runtime.json --socket /run/dsx-provisioner/provisioner.sock
Restart=on-failure
RestartSec=5
RuntimeDirectory=dsx-provisioner
RuntimeDirectoryMode=0750
StateDirectory=dsx-provisioner
StateDirectoryMode=0700
# The typed provisioner deliberately drops to the configured postgres OS account
# for fixed PostgreSQL argv and uses fixed systemd/nginx argv for Trial runtime.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/dsx-provisioner /var/lib/odoo/.local/share/Odoo/filestore /var/lib/dsx-backup-outbox /var/odoo /etc/systemd/system /etc/nginx/conf.d
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
UMask=0007

[Install]
WantedBy=multi-user.target
